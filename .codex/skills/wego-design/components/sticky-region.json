  ],
  "structurePatterns": [
    "固定结构为 .sticky-region > .sticky-region__motion > .sticky-region__inner > 业务内容。",
    "root 必须通栏并显式使用不透明背景；禁止把 root 放进带横向边距的内容组。",
    "运行时实测 motion 内容尺寸后设置 --sticky-region-expanded-size，并按策略写入 data-state。",
    "显隐只改变 max-height 与 transform，不得改变 opacity。",
    "首要导航、保存、结算和高优先级告警只能使用 always、compact-on-scroll、pin-after-threshold 或 elevate-after-scroll，不得 direction-reveal。"
  ],
  "behavior": {
    "measurement": "由 WegoScrollLayout 使用 ResizeObserver 实测展开尺寸、维护 sticky 栈偏移和主滚动区 scroll-padding。",
    "directionReveal": "累计同方向有效滚动超过阈值后切换；顶部强制显示，底部布局校正、尺寸变化和回弹不触发反向切换。",
    "compact": "越过阈值后切换 compact 状态，max-height 使用实测或配置的 compact size。",
    "pin": "越过阈值后切换 pinned；不改变文档滚动所有权。",
    "elevation": "越过阈值后只设置 data-elevated，不改变尺寸或 opacity。"
  },
  "accessibility": {
    "hiddenState": "hidden 状态同步 aria-hidden=true 且禁用指针事件；重新显示时恢复。",
    "focus": "运行时不得在焦点位于区域内部时自动隐藏。"
  },
  "usageHints": [
    "用于搜索栏、筛选栏、二级工具栏和可压缩摘要；navbar 仍直接消费 navbar 组件。",
    "存在动态吸顶或底部遮挡时绑定 WegoScrollLayout，并以实际尺寸验证滚动避让。",
    "多个区域按 stack_order 排序，运行时以实测高度计算 offset。",
    "内部横向留白通过 --sticky-region-inline-inset 配置为正式 page margin Token。"
  ],
  "doNotInvent": [
    "不要在业务场景复制滚动方向状态机。",
    "不要用 opacity、visibility 或 display 动画替代尺寸与位移动画。",
    "不要让 sticky surface 继承页面内容组横向边距。"
  ],
