      },
      {
        "selector": ".publish-product__capsule-label",
        "content_role": "胶囊标签字号",
        "css_property": "font-size",
        "token": "var(--body-sm-font-size)"
      },
      {
        "selector": ".publish-product__form-group",
        "content_role": "表单组标题颜色",
