  "prototype_brief": {
    "goal": "商家/店主从底部Tab栏第5个Tab进入，首要任务是管理店铺/相册内容（产品、笔记、直播），通过内容列表快速查看和操作已发布内容，辅助功能包括查看个人信息、会员状态、数据资产和常用应用入口。",
    "included": [
      "导航栏：左侧显示头像、相册名称、角色信息（默认超级管理员），右侧设置和分享主页两个入口",
      "会员栏：独立卡片，显示会员等级、到期时间、云空间用量",
      "数据资产横滑：9个入口（我买的、粉丝、好友、代理、访客、员工、钱包、卡券、收藏），我买的始终显示且有待办时加角标，点击后toast提示\"即将上线\"",
      "常用应用横滑：固定入口（进入主页、二维码）+ 最近应用（动态适配数量，最新使用靠前）+ 全部（跳转应用中心）",
      "类型tabs：产品/笔记/直播，紧贴列表，支持后续扩展",
      "工具行：搜索框 + 筛选按钮入口 + 视图切换，随tab联动",
      "内容列表：产品/笔记各有独立卡片结构（含分享、编辑、下载、刷新操作，分享为主），直播用纯图片宫格3:4比例，不显示状态标签，列表/网格视图per-tab独立记忆",
      "发布FAB：右下角悬浮按钮，点击后提示\"即将上线\""
    ],
    "excluded": [
      "导航栏左侧个人信息不跳转到相册详情页（本期不下钻）",
      "内容列表卡片不显示状态标签",
      "发布FAB不实现实际发布功能，仅做入口提示",
      "筛选按钮只作为入口，不实现筛选逻辑"
    ],
    "entry_points": [
      "底部Tab栏\"我的\"入口：底部导航栏，点击\"我的\"Tab进入",
      "数据资产入口：数据资产横滑区域，点击对应资产入口进入",
      "常用应用入口：常用应用横滑区域，点击应用图标进入对应功能",
      "发布FAB：页面右下角悬浮，点击后显示\"即将上线\"提示"
    ],
    "critical_paths": [
      "查看个人信息与会员状态：进入\"我的\"页面 → 查看导航栏头像、相册名称、角色信息 → 查看会员卡片等级、到期时间、云空间用量",
      "浏览数据资产：横向滑动数据资产区域 → 查看9个资产入口 → 点击入口进入对应资产页面",
      "使用常用应用：查看常用应用横滑区域 → 点击固定入口（进入主页、二维码）→ 查看最近使用的应用 → 点击\"全部\"进入应用中心",
      "浏览内容列表：切换类型Tab（产品/笔记/直播）→ 使用工具行搜索、筛选、视图切换 → 查看对应类型的内容卡片 → 列表/网格视图模式per-tab独立记忆"
