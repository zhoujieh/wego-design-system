  "scope_revision": 1,
  "brief_file": "bcg002-规格逐行计数-20260902.md",
  "prototype_brief": {
    "goal": "让开单人员在 Pad/桌面端添加有多个规格的商品时，可以在同一颜色下直接为多个规格分别录入数量，减少反复选规格和修改总数量的操作。\n\n---",
    "included": [
      "Pad/桌面端的“添加商品”默认模式保留颜色选择，规格改为竖向列表，一行一个规格。",
      "每个规格右侧显示独立计数器，同一颜色下可同时为多个规格设置数量。",
      "移除独立的“购买数量”区域，弹窗底部的件数和金额按各规格数量合计。",
      "切换颜色时清空上一颜色未提交的规格数量，避免隐藏数量被带入订单。"
    ],
    "excluded": [
      "不改变“一次买多件”模式的多颜色、多规格批量矩阵。",
      "不改变手机端商品添加流程。",
      "不调整商品价格、库存、优惠或订单合计规则。"
    ],
    "entry_points": [
      "Pad/桌面端开单页右侧商品库：点击商品卡片的添加入口后，在居中的“添加商品”弹窗默认模式中可见。"
    ],
    "critical_paths": [
      "[P1] 商品库 → 打开有颜色和规格的商品 → 选择颜色并在多个规格行中调整数量 → 底部合计即时更新，点击添加后对应规格和数量进入订单。",
      "商品添加弹窗 → 已为当前颜色的规格录入数量 → 切换到另一颜色 → 上一颜色未提交数量清空，新颜色各规格从 0 开始。",
      "商品添加弹窗 → 开启“一次买多件” → 进入原批量矩阵并录入多颜色规格数量 → 底部合计和添加结果保持现有能力。"
    ],
    "prototype_boundaries": [
      {
        "flow_id": "add-multiple-specs-under-one-color",
        "mode": "functional",
        "visible_result": "规格竖向排列，每行右侧可独立增减数量，底部件数和金额实时合计，确认后多个规格同时进入订单。"
      },
      {
        "flow_id": "reset-unsubmitted-quantities-on-color-change",
        "mode": "functional",
        "visible_result": "切换颜色后，上一颜色的未提交数量不再保留，当前颜色数量与底部合计均从 0 开始。"
      },
      {
        "flow_id": "retain-batch-purchase",
        "mode": "functional",
        "visible_result": "开启“一次买多件”后仍可通过现有批量矩阵录入多颜色、多规格数量。"
      }
    ],
    "states": [
      "默认主态：打开有多规格的商品且未开启“一次买多件” → 颜色可选，规格按行展示，每行数量为 0，底部件数和金额为 0。",
      "未选颜色：打开商品但尚未选择颜色 → 规格行仍可见，计数器不可操作，引导先选择颜色。",
      "已计数态：选择颜色并为一个或多个规格录入数量 → 对应行显示数量，底部同步显示合计件数和金额。",
      "库存上限态：某规格数量达到可售库存 → 该行增加操作不再增加数量，其他规格不受影响。",
      "颜色切换态：当前颜色已有未提交数量时选择另一颜色 → 原数量清空，新颜色所有规格数量为 0。",
      "空状态：当前商品没有可售规格 → 规格区显示“暂无可售规格”，添加按钮不可提交。",
      "加载态：商品信息正在准备 → 保持现有弹窗加载反馈，不显示虚假规格数据。",
      "失败态：商品信息无法读取 → 保持现有失败提示与关闭入口，不允许提交。"
    ],
    "data_contract": {
      "规格购买数量": {
        "字段": "商品 ID、颜色、规格、数量；数量为不小于 0 且不超过对应规格可售库存的整数。",
        "产生入口": "开单页“添加商品”弹窗中的规格行计数器。",
        "展示位置": "规格行右侧、弹窗底部合计以及提交后的当前订单商品区。",
        "修改方式": "通过每个规格行的减少、数量输入和增加操作修改；切换颜色时删除上一颜色未提交的数量。"
      }
    },
    "assumptions": [
      "规格行顺序沿用商品现有规格顺序，本次不新增排序规则。"
    ],
    "open_questions": []
  },
